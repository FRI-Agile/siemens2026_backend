# The ASP.NET API on localhost:8080 inside the pod, never published (container-deployment.md §1.3).
[Unit]
Description=HealthyHires API

[Container]
ContainerName=healthyhires-api
Image=@API_IMAGE@
Pod=healthyhires.pod
EnvironmentFile=/etc/healthyhires/api.env
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
# The ALTCHA signing key (ADR-022) is read from Key Vault at every start and the Podman copy deleted once the container
# has it, like the Collector's connection string (ADR-012: no secret on disk).
Secret=altcha-hmac-key,type=env,target=Altcha__HmacKey

[Service]
ExecStartPre=/usr/local/bin/hh-podman-secret altcha-hmac-key
ExecStartPost=/usr/bin/podman secret rm altcha-hmac-key
Restart=always

[Install]
WantedBy=default.target
